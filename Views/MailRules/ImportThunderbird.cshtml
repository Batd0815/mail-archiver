@model MailArchiver.ViewModels.ThunderbirdRuleImportViewModel
@{
    ViewData["Title"] = "Thunderbird-Regeln importieren";
}

<div class="container-fluid">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="h3 mb-1"><i class="bi bi-upload me-2"></i>Thunderbird-Regeln importieren</h1>
            <div class="text-muted">@Model.AccountName</div>
        </div>
        <a class="btn btn-outline-secondary" asp-controller="MailRules" asp-action="Index" asp-route-accountId="@Model.AccountId">Zurück zu Regeln</a>
    </div>

    <div class="alert alert-info">
        Die Datei wird zunächst nur geprüft. Unterstützt werden Thunderbird-Regeln mit einer einzelnen „Absender/Betreff enthält“-Bedingung,
        der Aktion „Move to folder“ und Zielen unter „Local Folders“. Beim späteren Import werden Regeln und fehlende Zielordner angelegt,
        aber alle Regeln bleiben zunächst pausiert. Bereits archivierte Mails werden nicht verändert.
    </div>
    <div class="alert alert-warning">
        Thunderbird-Regeltyp 17 gilt für eingehende Mails und manuelle Ausführung. Für automatische neue Synchronisationen begrenzen wir
        importierte Regeln auf den Ausgangsordner INBOX. Die Reihenfolge aus der Datei bleibt erhalten; bei Treffern gilt die erste passende Regel.
    </div>

    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <form asp-controller="ThunderbirdRuleImport" asp-action="Preview" method="post" enctype="multipart/form-data" class="card card-body">
        @Html.AntiForgeryToken()
        <input type="hidden" name="accountId" value="@Model.AccountId" />
        <label class="form-label" for="file">Thunderbird-Datei</label>
        <input class="form-control" type="file" id="file" name="file" accept=".dat" required />
        <div class="form-text">Wähle die Kopie deiner <code>msgFilterRules.dat</code> aus (maximal 512 KB).</div>
        <div class="mt-3">
            <button class="btn btn-primary" type="submit"><i class="bi bi-search me-1"></i>Datei prüfen</button>
            <a class="btn btn-outline-secondary" asp-controller="MailRules" asp-action="Index" asp-route-accountId="@Model.AccountId">Abbrechen</a>
        </div>
    </form>
</div>
